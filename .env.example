# NIGHTHAWK OSINT environment configuration
# Copy this file to .env and adjust values. Never commit real secrets.

# Dashboard
NIGHTHAWK_HOST=127.0.0.1
NIGHTHAWK_PORT=8000
NIGHTHAWK_DEBUG=false

# Optional API integrations (leave unset to run without these providers)
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
HIBP_API_KEY=
# Optional public IP reputation provider. Queried IPs are sent to AbuseIPDB.
ABUSEIPDB_API_KEY=

# Explicit opt-in: sends entered email/username/domain/public IP to configured
# Brave/Tavily search providers to find possible public references. Default: off.
NIGHTHAWK_ENABLE_PUBLIC_SEARCH=false

# Rate limits (requests per second per provider, approximate)
NIGHTHAWK_RATE_LIMIT_DEFAULT=1.0
NIGHTHAWK_HTTP_TIMEOUT=15
